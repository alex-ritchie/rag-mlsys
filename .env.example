# ---- shared -------------------------------------------------------------
# Every service reads these; nothing is hardcoded. Copy to .env for docker compose / make dev.
PROFILE=local                                  # local | demo
DATABASE_URL=postgresql+asyncpg://mlsys:mlsys@localhost:5432/mlsys
LOG_LEVEL=info

# ---- gateway ------------------------------------------------------------
GATEWAY_PORT=8000
EMBEDDER_URL=http://localhost:8001             # local profile: external embedder service
RERANKER_URL=http://localhost:8002             # empty string => skip reranking (hybrid-only)
LLM_BASE_URL=http://localhost:8003/v1          # vLLM / llama.cpp OpenAI-compatible endpoint
LLM_MODEL=qwen38-27b-w4a16
LLM_API_KEY=none
RETRIEVAL_MODE=hybrid                          # hybrid | dense  (ablation flag, spec §5.2)
RETRIEVAL_TOP_N=30
RERANK_TOP_K=5
PROMPT_VERSION=v1
MAX_OUTPUT_TOKENS=1024
DISABLE_THINKING=true                          # Qwen3.8 reasons by default; off for the serving path (§5.4)

# ---- embedder / reranker services ---------------------------------------
EMBEDDER_MODE=cpu                              # cpu | gpu | onnx
EMBEDDER_MODEL=BAAI/bge-m3
RERANKER_MODE=cpu                              # cpu | gpu | onnx
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_HOME=data/hf-cache

# ---- demo profile (PROFILE=demo) ----------------------------------------
ANTHROPIC_API_KEY=                             # server-side only, never shipped to the browser
DEMO_GENERATION_MODEL=claude-haiku-4-5
DEMO_EMBEDDER=inprocess-onnx                   # query embedding in-process (CPU ONNX bge-m3)
DEMO_RERANK=onnx                               # onnx | off   (decided in M10 by the <1 s rerank budget)
DEMO_RATE_LIMIT_PER_DAY=10                     # per-IP sliding window (stored in the demo DB)
DEMO_DAILY_BUDGET_USD=2.00                     # global hard stop
DEMO_HAIKU_INPUT_USD_PER_MTOK=1.00             # used for spend accounting
DEMO_HAIKU_OUTPUT_USD_PER_MTOK=5.00
SUPABASE_DB_URL=                               # postgresql+asyncpg://... (demo retrieval DB)

# ---- eval / judge -------------------------------------------------------
JUDGE_MODEL=claude-haiku-4-5
GOLDEN_GEN_MODEL=claude-haiku-4-5

# ---- frontend (Vite, build-time) ----------------------------------------
VITE_API_BASE=http://localhost:8000
VITE_PROFILE=local                             # local | demo  (controls the demo framing copy)
